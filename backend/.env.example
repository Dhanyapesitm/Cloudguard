# Generate independent random values before any non-demo deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDGUARD_JWT_SECRET=replace-with-a-long-random-secret
# Base64 encoding of exactly 32 random bytes. Keep this key private and backed up.
CLOUDGUARD_FILE_KEY=replace-with-base64-encoded-32-byte-key
CLOUDGUARD_DATABASE=cloudguard.db
CLOUDGUARD_ENV=development
CLOUDGUARD_WHISPER_MODEL=small.en
CLOUDGUARD_DEEPFACE_ENGINE=tensorflow
