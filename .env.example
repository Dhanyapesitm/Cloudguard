# CloudGuard Frontend Environment Variables
# Copy this file to .env or .env.local to configure Supabase authentication.

# 1. Supabase Project URL (find in Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Publishable API Key (find in Supabase Dashboard -> Project Settings -> API -> Project API Keys)
# CloudGuard supports both:
#   - New Supabase publishable key format: starts with "sb_publishable_" (recommended)
#   - Legacy anon JWT format: starts with "ey..."
# Preferred variable name: VITE_SUPABASE_PUBLISHABLE_KEY
# (VITE_SUPABASE_ANON_KEY is also supported as a backwards-compatible fallback)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: CloudGuard Backend API URL (defaults to /api which proxies to http://127.0.0.1:8000)
# VITE_API_URL=http://localhost:8000/api
